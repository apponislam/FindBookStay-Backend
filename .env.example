# Environment
NODE_ENV=development
IP=0.0.0.0
PORT=5075

# MongoDB
MONGODB_URL=mongodb+srv://<YOUR_MONGO_USER>:<YOUR_MONGO_PASS>@cluster0.mongodb.net/FindBookStay?retryWrites=true&w=majority

# Security
BCRYPT_SALT_ROUNDS=12

# Client
CLIENT_URL=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=<YOUR_ACCESS_SECRET>
JWT_ACCESS_EXPIRE=30d
JWT_REFRESH_SECRET=<YOUR_REFRESH_SECRET>
JWT_REFRESH_EXPIRE=365d
JWT_PASSWORD_RESET_SECRET=<YOUR_PASSWORD_RESET_SECRET>

# MAIL SYSTEM
MAIL=RESEND # NODEMAILER | RESEND

# NODEMAILER (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<YOUR_EMAIL>
SMTP_PASS="<YOUR_EMAIL_APP_PASSWORD>"

# RESEND API
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
RESEND_FROM_EMAIL=onboarding@resend.dev

# INITIAL ADMIN
INITIAL_ADMIN_NAME="Md. Appon Islam"
INITIAL_ADMIN_EMAIL=admin@findbookstay.com
INITIAL_ADMIN_PASSWORD=your_admin_password
INITIAL_ADMIN_PHONE=+8801700000000

# REDIS
REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# MAPS API (Optional)
MAPS_API_KEY=<YOUR_MAPS_API_KEY>
